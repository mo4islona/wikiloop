{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/../hooks/session_start.py\" \"${CLAUDE_PLUGIN_ROOT}/hooks/wikiloop.json\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/../hooks/track.py\" \"${CLAUDE_PLUGIN_ROOT}/hooks/wikiloop.json\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/../hooks/candidate_gate.py\" \"${CLAUDE_PLUGIN_ROOT}/hooks/wikiloop.json\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Skill|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/../hooks/track.py\" \"${CLAUDE_PLUGIN_ROOT}/hooks/wikiloop.json\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/../hooks/stop.py\" \"${CLAUDE_PLUGIN_ROOT}/hooks/wikiloop.json\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
